{
  "name": "estafet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm i18n:check && pnpm test",
    "db:start": "supabase start -x imgproxy,edge-runtime,logflare,vector,supavisor,mailpit",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm seed:storage && pnpm seed:admin",
    "seed:storage": "tsx scripts/seed-storage.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "test:e2e:admin": "playwright test tests/e2e/admin.spec.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "shots": "tsx scripts/screenshots.ts",
    "shots:design": "tsx scripts/screenshots-design.ts",
    "perf": "tsx scripts/perf-check.ts",
    "cloud-sql": "node scripts/build-cloud-sql.mjs",
    "deletions:process": "tsx scripts/process-deletions.ts",
    "test:db:purge": "vitest run --config vitest.db.purge.config.ts",
    "config:check": "tsx scripts/check-config.ts",
    "restore:drill": "node scripts/restore-drill.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "framer-motion": "^14.14.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.76.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "nodemailer": "^10.6.1",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.21.0"
}
