# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
# Either name works: the classic anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Either name works: the classic service role key or the newer secret key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Optional, scripts only (never read by the app): Postgres connection string of a DEVELOPMENT or DEMO project, used by
# `pnpm seed:dev`. Supabase dashboard, Connect, Session pooler (port 5432), with your database password. Keep it secret.
SUPABASE_DB_URL=
LLM_PROVIDER=mock                # gemini | anthropic | mock
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ALLOWED_EMAIL_DOMAINS=            # optional restriction, comma separated. Empty (default) = any email address can sign up
MAX_UPLOAD_MB=25
SYNTHESIS_DAILY_CAP=20
APP_URL=http://localhost:3000

# Admin area
APP_ENV=LOCAL                     # LOCAL | STAGING | PRODUCTION (decides the badge and whether "Purge demo data" is allowed)
SEED_DEMO=false                   # true only for local demos: creates the demo admin account. Never in production.
CONTACT_EMAIL=                    # shown on the Contact page and to suspended users (can also be set in /admin/settings)
REAUTH_SECRET=                    # optional: signs the 15 minute re-authentication cookie (defaults to a key derived from the service role key)

# Reports and moderation (R5). Settings in /admin/settings override these.
REPORT_HOLD_THRESHOLD=3           # different reporters needed for an automatic hold (minimum 2)
HOLD_REVIEW_DAYS=3                # a held project should be reviewed within this many days
# Bot check for guest reports. Without these, a local check (hidden field + minimum fill time) is used instead.
# The Cloudflare Turnstile path has NOT been tested against Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=             # server only

# Production readiness (R7). See docs/environments.md. `pnpm config:check` tells you what a deployed server would refuse.
CRON_SECRET=                      # 32+ random characters. Scheduled jobs (/api/cron/*) need it as a bearer token
SYNTHESIS_GLOBAL_DAILY_CAP=300    # live AI runs for everyone together per 24 h
EMAIL_PROVIDER=none               # none | log | smtp | resend  (production needs smtp or resend)
EMAIL_FROM=                       # for example: ESTAFET <halo@your-domain>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                    # server only
RESEND_API_KEY=                   # server only
UPLOAD_SCAN_URL=                  # optional malware scanner endpoint (see docs/security.md)
ALERT_WEBHOOK_URL=                # optional Slack or Discord compatible webhook for alerts
# RATE_LIMIT_MULTIPLIER is for local browser tests only (scripts/dev-local.mjs sets it). A deployed server refuses it.

