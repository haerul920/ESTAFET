# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
# Either name works: the classic anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Either name works: the classic service role key or the newer secret key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
LLM_PROVIDER=mock                 # gemini | anthropic | mock
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ALLOWED_EMAIL_DOMAINS=            # optional restriction, comma separated. Empty (default) = any email address can sign up
MAX_UPLOAD_MB=25
SYNTHESIS_DAILY_CAP=20
APP_URL=http://localhost:3000

# Admin area
APP_ENV=LOCAL                     # LOCAL | STAGING | PRODUCTION (decides the badge and whether "Purge demo data" is allowed)
SEED_DEMO=false                   # true only for local demos: creates the demo admin account. Never in production.
CONTACT_EMAIL=                    # shown on the Contact page and to suspended users (can also be set in /admin/settings)
REAUTH_SECRET=                    # optional: signs the 15 minute re-authentication cookie (defaults to a key derived from the service role key)

# Reports and moderation (R5). Settings in /admin/settings override these.
REPORT_HOLD_THRESHOLD=3           # different reporters needed for an automatic hold (minimum 2)
HOLD_REVIEW_DAYS=3                # a held project should be reviewed within this many days
# Bot check for guest reports. Without these, a local check (hidden field + minimum fill time) is used instead.
# The Cloudflare Turnstile path has NOT been tested against Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=             # server only
